---
import Analytics from "../../components/Analytics.astro";
import SiteNav from "../../components/SiteNav.astro";
import buildInfo from "../../data/build-info.json";
import "../../styles/global.css";

export function getStaticPaths() {
  return buildInfo.collections.map((entry) => ({
    params: { slug: entry.slug },
    props: entry,
  }));
}

const { name, slug, count } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${name} 分类的 Warcraft III 地图，共 ${count} 张。`} />
    <link rel="preconnect" href="https://huggingface.co" crossorigin />
    <link rel="preload" href={`${base}data/categories/${slug}/0.json`} as="fetch" crossorigin />
    <title>{name} · Warcraft III 地图资料库</title>
  </head>
  <body>
    <header class="hero compact">
      <SiteNav />
      <div class="wrap hero-content">
        <p class="eyebrow">CATEGORY</p>
        <h1>{name}</h1>
        <p class="intro">共 {count} 张地图。也可以直接在下面搜索，不必回到首页。</p>
        <form id="search-form" class="search" role="search">
          <label class="sr-only" for="search-input">搜索地图</label>
          <input id="search-input" type="search" autocomplete="off" placeholder="搜索地图名、作者或文件名…" />
          <button type="submit">搜索</button>
        </form>
        <label class="scope">
          <input id="search-scope" type="checkbox" checked />
          <span>仅在「{name}」内搜索</span>
        </label>
      </div>
    </header>

    <main class="wrap content">
      <section class="toolbar" aria-label="筛选和排序">
        <nav class="categories" aria-label="地图分类">
          {buildInfo.collections.map((entry) => (
            <a
              href={base + `categories/${entry.slug}/`}
              aria-current={entry.slug === slug ? "page" : undefined}
            >
              {entry.name} {entry.count}
            </a>
          ))}
        </nav>
        <label class="sort">
          <span>排序</span>
          <select id="sort-select">
            <option value="relevance">相关度</option>
            <option value="name">名称</option>
            <option value="size-desc">文件大小</option>
            <option value="players-desc">玩家人数</option>
          </select>
        </label>
      </section>

      <div id="notice" class="notice" role="status">正在载入地图…</div>
      <section
        id="results"
        class="results"
        aria-label={`${name} 地图列表`}
        data-collection={name}
        data-total={count}
      ></section>
      <button id="load-more" class="load-more" type="button" hidden>显示更多</button>
    </main>

    <footer class="wrap footer">
      <p>地图版权归各自作者所有。本项目提供保存、检索和完整性校验。</p>
      <p>
        <a href={base}>返回首页</a>
      </p>
    </footer>
    <script>
      import "../../scripts/browser.js";
    </script>
    <Analytics />
  </body>
</html>
