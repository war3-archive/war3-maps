---
import Analytics from "../components/Analytics.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/global.css";

const SECTIONS = [
  ["overview", "概览"],
  ["teams", "队伍"],
  ["tech", "科技"],
  ["images", "图像"],
  ["strings", "字符串"],
  ["imports", "导入"],
  ["files", "文件"],
  ["json", "JSON"],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="在浏览器里解析 Warcraft III 地图：文件不上传，全部在本地完成。"
    />
    <meta name="theme-color" content="#171c18" />
    <title>地图解析 · Warcraft III 地图资料库</title>
  </head>
  <body>
    <header class="hero compact">
      <SiteNav />
      <div class="wrap hero-content">
        <p class="eyebrow">LOCAL MAP INSPECTOR</p>
        <h1>拖进来，<em>看个明白。</em></h1>
        <p class="lede">
          解析在你的浏览器里跑，地图不会上传到任何服务器。支持 .w3x / .w3m / .w3n。
        </p>
      </div>
    </header>

    <main class="parse">
      <div class="wrap">
        <section id="drop" class="drop" tabindex="0" role="button" aria-label="选择地图文件">
          <input id="file" type="file" accept=".w3x,.w3m,.w3n,.mpq" hidden />
          <p class="drop-main">把地图文件拖到这里，或点击选择</p>
          <p id="status" class="drop-status">正在加载解析器…</p>
        </section>
      </div>

      <nav id="secnav" class="secnav" hidden aria-label="解析结果导航">
        <div class="wrap secnav-inner">
          {
            SECTIONS.map(([id, label]) => (
              <a class="seclink" href={`#${id}`} data-link={id}>
                {label}
                <span class="seccount" data-count={id} />
              </a>
            ))
          }
        </div>
      </nav>

      <div id="sections" class="wrap sections" hidden>
        {
          SECTIONS.map(([id, label]) => (
            <section class="section" id={id} data-section={id}>
              <h2 class="section-head">{label}</h2>
              <div class="section-body" data-panel={id} />
            </section>
          ))
        }
      </div>
    </main>

    <Analytics />

    <style is:global>
      /* The section bodies are built by parse.ts, so Astro's scoping never
         reaches them — these rules are global, held in by the .parse prefix. */
      html { scroll-behavior: smooth; }

      .parse { padding: 32px 0 64px; }
      .parse [hidden] { display: none !important; }

      .parse .drop {
        border: 1px dashed #4a5449;
        border-radius: 14px;
        padding: 40px 20px;
        text-align: center;
        cursor: pointer;
        background: #161b17;
        transition: border-color .15s, background .15s;
      }
      .parse .drop:hover, .parse .drop:focus-visible, .parse .drop.over {
        border-color: #c99e48; background: #1a2019;
      }
      .parse .drop-main { margin: 0 0 8px; font-weight: 600; }
      .parse .drop-status { margin: 0; color: #9aa398; font: 500 13px/1.5 ui-monospace, monospace; }
      .parse .drop-status.err { color: #e2795f; }
      .parse .drop-status.ok { color: #8fbf6a; }

      /* Sticky section nav: follows the page and tracks the section in view. */
      .parse .secnav {
        position: sticky; top: 0; z-index: 5; margin-top: 24px;
        background: rgba(16, 20, 17, .92);
        backdrop-filter: blur(8px);
        border-block: 1px solid #39413a;
      }
      .parse .secnav-inner {
        display: flex; gap: 4px; overflow-x: auto; padding: 8px 0;
        scrollbar-width: thin;
      }
      .parse .seclink {
        flex: none; text-decoration: none; border-radius: 999px;
        border: 1px solid transparent; padding: 6px 13px;
        color: #9aa398; font: 600 13px/1 inherit; white-space: nowrap;
      }
      .parse .seclink:hover { color: #e9eadf; }
      .parse .seclink[aria-current="true"] {
        border-color: #c99e48; color: #e9eadf; background: #202820;
      }
      .parse .seccount { color: #6f7770; font-weight: 500; }
      .parse .seccount:not(:empty)::before { content: " "; }

      .parse .sections { display: grid; }
      .parse .section { scroll-margin-top: 64px; padding: 26px 0 6px; }
      .parse .section + .section { border-top: 1px solid #2b322c; }
      .parse .section-head { margin: 0 0 16px; font: 700 20px/1.2 inherit; color: #e9eadf; }
      .parse .section-head::before {
        content: ""; display: inline-block; width: 4px; height: 18px;
        margin-right: 10px; border-radius: 2px; background: #c99e48;
        vertical-align: -2px;
      }
      .parse .section-body { display: grid; gap: 16px; }

      .parse .pcard {
        border: 1px solid #39413a; border-radius: 12px; background: #161b17; padding: 16px 18px;
      }
      .parse .pcard > h3 {
        margin: 0 0 12px; font: 600 11px/1.2 ui-monospace, monospace;
        letter-spacing: .08em; text-transform: uppercase; color: #c99e48;
      }

      .parse .kv { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
      .parse .kv dt { color: #8a9287; font-size: 13px; }
      .parse .kv dd { margin: 0; font-size: 14px; overflow-wrap: anywhere; }

      .parse .chips { display: flex; flex-wrap: wrap; gap: 6px; }
      .parse .chip {
        border: 1px solid #39413a; border-radius: 999px; padding: 3px 10px;
        font: 500 12px/1.5 ui-monospace, monospace; color: #c8cfc4;
      }

      .parse table.grid { width: 100%; border-collapse: collapse; font-size: 13px; }
      .parse table.grid th, .parse table.grid td {
        text-align: left; padding: 6px 10px; border-bottom: 1px solid #2b322c; vertical-align: top;
      }
      .parse table.grid th { color: #8a9287; font-weight: 600; white-space: nowrap; }
      .parse .scroll { overflow-x: auto; }
      .parse .tall { max-height: 460px; overflow-y: auto; }

      .parse .swatch {
        display: inline-block; width: 9px; height: 9px; border-radius: 2px;
        margin-right: 6px; border: 1px solid #4a5449; vertical-align: baseline;
      }

      .parse .shots { display: flex; flex-wrap: wrap; gap: 14px; }
      .parse .shot { display: grid; gap: 6px; justify-items: center; margin: 0; }
      .parse .shot img, .parse .shot canvas {
        image-rendering: pixelated; background: #0d100e;
        border: 1px solid #39413a; border-radius: 8px; max-width: 320px; height: auto;
      }
      .parse .shot figcaption { color: #8a9287; font: 500 12px/1.4 ui-monospace, monospace; }

      .parse .filter {
        width: 100%; margin-bottom: 10px; padding: 7px 10px; border-radius: 8px;
        border: 1px solid #39413a; background: #101411; color: inherit; font: inherit;
      }

      .parse pre.json {
        margin: 0; max-height: 560px; overflow: auto; font-size: 12px; line-height: 1.5;
        color: #c8cfc4;
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
    </style>

    <script>
      import "../scripts/parse.ts";
    </script>
  </body>
</html>
