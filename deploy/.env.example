# Copy to .env and fill in.  `war3-deploy` loads this automatically (dotenv).
# .env is git-ignored; never commit real keys.

# --- classify-tags: remote classification via OpenRouter (no local model) ---
WAR3_TAG_LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
WAR3_TAG_LLM_MODEL=deepseek/deepseek-v4-flash-0731
# Key from https://openrouter.ai/settings/keys (sk-or-v1-...)
OPENROUTER_API_KEY=

# --- local fallback (llama.cpp / MLX server on this machine) ---
# WAR3_TAG_LLM_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
# WAR3_TAG_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit

# --- upload: Hugging Face token (or `hf auth login`) ---
# HF_TOKEN=hf_...
